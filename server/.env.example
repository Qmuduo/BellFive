# Node 22+; export these variables in the server process before starting.
PORT=8787
HOST=0.0.0.0
# Use a durable mounted path in deployments; this default is relative to the repository root.
BELLFIVE_AUTH_DB_PATH=server/data/bellfive.sqlite
# Exact browser origins, comma-separated. This does not configure WeChat Mini Program domains.
BELLFIVE_CORS_ORIGINS=http://localhost:8081
# Server-only mini-program credentials. Leave empty for password-only development.
BELLFIVE_WECHAT_MINI_APP_ID=
BELLFIVE_WECHAT_MINI_APP_SECRET=
# Required for production guardian consent emails. Use the public HTTPS origin/root only.
BELLFIVE_PUBLIC_BASE_URL=https://api.example.com
BELLFIVE_SMTP_HOST=
BELLFIVE_SMTP_PORT=587
BELLFIVE_SMTP_SECURE=false
BELLFIVE_SMTP_USER=
BELLFIVE_SMTP_PASSWORD=
BELLFIVE_SMTP_FROM=
